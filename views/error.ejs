<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Error – E-Card</title>
<style>
  body { background: #050d1a; font-family: 'Barlow', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #c8daf0; }
  .error-page { text-align: center; }
  .error-code { font-size: 60px; font-weight: 800; color: #ff6b6b; opacity: 0.5; }
  .error-text { font-size: 14px; color: #4a6a8a; margin-top: 10px; }
  .error-link { display: inline-block; margin-top: 30px; font-size: 12px; color: #00d4ff; text-decoration: none; border: 1px solid rgba(0,212,255,0.3); padding: 10px 24px; border-radius: 8px; }
</style>
</head>
<body>
  <div class="error-page">
    <div class="error-code">500</div>
    <div class="error-text"><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></div>
    <a href="/" class="error-link">← RETURN HOME</a>
  </div>
</body>
</html>
