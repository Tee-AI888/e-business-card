<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= card && card.id ? 'Edit' : 'New' %> Card – E-Card Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= card && card.id ? 'Edit' : 'New' %> Card</h1>
        <p class="page-subtitle">
          <% if (card && card.id) { %>
            Editing: <%= card.name_en %>
            <a href="/card/<%= card.uuid %>" target="_blank" class="preview-link">View Public Card →</a>
          <% } else { %>
            Fill in the details to create a new e-business card
          <% } %>
        </p>
      </div>
      <div class="header-actions">
        <a href="/admin/cards" class="btn btn-ghost">← BACK</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <form
      method="POST"
      action="<%= card && card.id ? '/api/cards/' + card.id + '/update' : '/api/cards' %>"
      enctype="multipart/form-data"
      class="card-form"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid">
        <!-- Left Column: Personal Info -->
        <div class="form-section">
          <h3 class="form-section-title">Personal Information</h3>

          <div class="form-group">
            <label class="form-label">Name (English) *</label>
            <input class="form-input" type="text" name="name_en" value="<%= card ? (card.name_en || '') : '' %>" required placeholder="e.g. John Doe">
          </div>

          <div class="form-group">
            <label class="form-label">Name (Thai)</label>
            <input class="form-input" type="text" name="name_th" value="<%= card ? (card.name_th || '') : '' %>" placeholder="e.g. จอห์น โด">
          </div>

          <div class="form-group">
            <label class="form-label">Job Title</label>
            <input class="form-input" type="text" name="title" value="<%= card ? (card.title || '') : '' %>" placeholder="e.g. Head of IT">
          </div>

          <div class="form-group">
            <label class="form-label">Department</label>
            <input class="form-input" type="text" name="department" value="<%= card ? (card.department || '') : '' %>" placeholder="e.g. IT">
          </div>

          <div class="form-group">
            <label class="form-label">Profile Image</label>
            <div class="file-upload-wrap">
              <% if (card && card.id && card.profile_image) { %>
                <img class="preview-img" id="previewImg" src="<%= card.profile_image %>" alt="Current photo">
                <label style="display:inline-flex;align-items:center;gap:6px;margin-top:6px;font-size:12px;color:#ff4d6a;cursor:pointer">
                  <input type="checkbox" name="delete_profile" value="1" onchange="if(this.checked){document.getElementById('previewImg').style.opacity='0.3'}else{document.getElementById('previewImg').style.opacity='1'}"> Remove current image
                </label>
              <% } else { %>
                <div class="preview-img placeholder" id="previewImg">No image</div>
              <% } %>
              <input class="form-input" type="file" name="profile_image" accept=".jpg,.jpeg,.png,.webp" onchange="previewImage(this)">
              <small class="form-hint">Max 2MB. JPG, PNG, or WebP</small>
            </div>
          </div>
        </div>

        <!-- Right Column: Company & Contact -->
        <div class="form-section">
          <h3 class="form-section-title">Company</h3>

          <div class="form-group">
            <label class="form-label">Select Company (Master)</label>
            <select class="form-input" id="companySelector" onchange="fillCompany(this.value)">
              <option value="">— Manual input —</option>
              <% companies.forEach(c => { %>
                <option value="<%= c.id %>"
                  data-name-th="<%= c.name_th || '' %>"
                  data-name-en="<%= c.name_en || '' %>"
                  data-address="<%= c.address || '' %>"
                  data-office-phone="<%= c.office_phone || '' %>"
                  data-website="<%= c.website || '' %>"
                  <%= (card && card.company_id && card.company_id == c.id) ? 'selected' : '' %>
                ><%= c.name_en %></option>
              <% }) %>
            </select>
            <small class="form-hint">Select to auto-fill company fields, or type manually below</small>
            <input type="hidden" name="company_id" id="companyIdField" value="<%= card && card.company_id ? card.company_id : '' %>">
          </div>

          <div class="form-group">
            <label class="form-label">Company (English)</label>
            <input class="form-input" type="text" name="company_en" id="companyEnField" value="<%= card ? (card.company_en || '') : '' %>" placeholder="e.g. Acme Corp.">
          </div>

          <div class="form-group">
            <label class="form-label">Company (Thai)</label>
            <input class="form-input" type="text" name="company_th" id="companyThField" value="<%= card ? (card.company_th || '') : '' %>" placeholder="e.g. บริษัท แอคมี่ จำกัด">
          </div>

          <h3 class="form-section-title" style="margin-top: 20px;">Contact Details</h3>

          <div class="form-group">
            <label class="form-label">Mobile</label>
            <input class="form-input" type="text" name="mobile" value="<%= card ? (card.mobile || '') : '' %>" placeholder="e.g. +66659386162">
          </div>

          <div class="form-group">
            <label class="form-label">Mobile 2</label>
            <input class="form-input" type="text" name="mobile2" value="<%= card ? (card.mobile2 || '') : '' %>" placeholder="e.g. +66812345678">
          </div>

          <div class="form-group">
            <label class="form-label">Office Phone</label>
            <input class="form-input" type="text" name="office_phone" id="officePhoneField" value="<%= card ? (card.office_phone || '') : '' %>" placeholder="e.g. +6624212150 Ext. 1630">
          </div>

          <div class="form-group">
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" value="<%= card ? (card.email || '') : '' %>" placeholder="e.g. john@company.com">
          </div>

          <div class="form-group">
            <label class="form-label">Website</label>
            <input class="form-input" type="text" name="website" id="websiteField" value="<%= card ? (card.website || '') : '' %>" placeholder="e.g. www.company.com">
          </div>

          <div class="form-group">
            <label class="form-label">Address</label>
            <textarea class="form-input form-textarea" name="address" id="addressField" rows="3" placeholder="Full address"><%= card ? (card.address || '') : '' %></textarea>
          </div>
        </div>
      </div>

      <!-- Theme Selection -->
      <div class="form-section full-width">
        <h3 class="form-section-title">Theme</h3>
        <div class="theme-selector">
          <% themes.forEach(t => { %>
            <label class="theme-option">
              <input type="radio" name="theme_id" value="<%= t.id %>"
                <%= (card && card.theme_id == t.id) || (!card && t.slug === 'cyberpunk') ? 'checked' : '' %>>
              <div class="theme-preview theme-<%= t.slug %>">
                <div class="theme-name"><%= t.name %></div>
                <div class="theme-desc"><%= t.description || '' %></div>
                <% if (t.is_system) { %><span class="theme-system-badge">System</span><% } %>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">
          <%= card && card.id ? '✓ SAVE CHANGES' : '⊕ CREATE CARD' %>
        </button>
        <a href="/admin/cards" class="btn btn-ghost">CANCEL</a>
      </div>
    </form>

    <% if (card && card.id) { %>
    <div class="form-actions" style="margin-top:24px; flex-direction:column; align-items:flex-start;">
      <h3 style="color:#ff4d6a; font-size:11px; font-family:var(--mono); letter-spacing:2px; text-transform:uppercase; margin-bottom:4px;">⚠ DANGER ZONE</h3>
      <form method="POST" action="/api/cards/<%= card.id %>/delete" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this card?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-danger">🗑 DELETE CARD</button>
      </form>
    </div>
    <% } %>
  </main>

  <script>
    function fillCompany(id) {
      var sel = document.getElementById('companySelector');
      var opt = sel.options[sel.selectedIndex];
      document.getElementById('companyIdField').value = id || '';
      if (id) {
        document.getElementById('companyEnField').value = opt.dataset.nameEn || '';
        document.getElementById('companyThField').value = opt.dataset.nameTh || '';
        document.getElementById('officePhoneField').value = opt.dataset.officePhone || '';
        document.getElementById('websiteField').value = opt.dataset.website || '';
        document.getElementById('addressField').value = opt.dataset.address || '';
      }
    }

    function previewImage(input) {
      const preview = document.getElementById('previewImg');
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
          if (preview.tagName === 'IMG') {
            preview.src = e.target.result;
          } else {
            const img = document.createElement('img');
            img.className = 'preview-img';
            img.id = 'previewImg';
            img.src = e.target.result;
            preview.replaceWith(img);
          }
        };
        reader.readAsDataURL(input.files[0]);
      }
    }
  </script>
</body>
</html>
