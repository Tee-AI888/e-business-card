<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= theme && theme.id ? 'Edit' : 'New' %> Theme – E-Card Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
<style>
  .theme-editor-layout {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 24px;
    align-items: start;
  }
  .live-preview-panel {
    position: sticky;
    top: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: #111;
  }
  .live-preview-panel .preview-header {
    padding: 8px 14px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .live-preview-panel .preview-header .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent3);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .live-preview-panel iframe {
    width: 100%;
    height: 680px;
    border: none;
    display: block;
  }
  @media (max-width: 1100px) {
    .theme-editor-layout { grid-template-columns: 1fr; }
    .live-preview-panel { position: relative; top: 0; order: -1; }
    .live-preview-panel iframe { height: 500px; }
  }

  /* Font library selector */
  .font-selector-wrap { display: flex; flex-direction: column; gap: 6px; }
  .font-selector-wrap select {
    width: 100%;
    padding: 8px 10px;
    background: var(--panel, #080f1e);
    color: var(--text, #c8daf0);
    border: 1px solid var(--border, #1a3060);
    border-radius: 6px;
    font-family: var(--mono, monospace);
    font-size: 12px;
    cursor: pointer;
    appearance: auto;
  }
  .font-selector-wrap select:focus { border-color: var(--accent, #00d4ff); outline: none; }
  .font-selector-wrap .form-input { margin: 0; }
  .font-selector-wrap small { font-size: 10px; color: var(--text-dim, #4a6a8a); }
</style>
</head>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= theme && theme.id ? 'Edit' : 'New' %> Theme</h1>
        <p class="page-subtitle">
          <% if (theme && theme.id) { %>
            Editing: <%= theme.name %>
            <% if (theme.is_system) { %><span class="badge">System theme — template locked</span><% } %>
          <% } else { %>
            Create a custom theme by choosing a base template and customizing colors
          <% } %>
        </p>
      </div>
      <div class="header-actions">
        <a href="/admin/themes" class="btn btn-ghost">← BACK</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <%
      let currentVars = {};
      if (theme && theme.css_variables) {
        try { currentVars = typeof theme.css_variables === 'string' ? JSON.parse(theme.css_variables) : theme.css_variables; } catch(e) {}
      }
    %>

    <div class="theme-editor-layout">
      <!-- Left: Form -->
      <div>
        <form
          method="POST"
          action="<%= theme && theme.id ? '/api/themes/' + theme.id + '/update' : '/api/themes' %>"
          class="card-form"
          id="themeForm"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="form-grid">
            <div class="form-section">
              <h3 class="form-section-title">Basic Info</h3>

              <div class="form-group">
                <label class="form-label">Theme Name *</label>
                <input class="form-input" type="text" name="name" value="<%= theme ? (theme.name || '') : '' %>" required placeholder="e.g. Ocean Blue">
              </div>

              <% if (!(theme && theme.id)) { %>
              <div class="form-group">
                <label class="form-label">Slug *</label>
                <input class="form-input" type="text" name="slug" value="<%= theme ? (theme.slug || '') : '' %>" required placeholder="e.g. ocean-blue" pattern="[a-z0-9-]+">
                <small class="form-hint">Lowercase letters, numbers, and hyphens only</small>
              </div>
              <% } %>

              <div class="form-group">
                <label class="form-label">Description</label>
                <textarea class="form-input form-textarea" name="description" rows="3" placeholder="Brief description of the theme"><%= theme ? (theme.description || '') : '' %></textarea>
              </div>

              <div class="form-group">
                <label class="form-label">Template File *</label>
                <div style="display:flex;gap:8px;align-items:center">
                  <span style="font-family:var(--mono,'monospace');font-size:11px;color:var(--text-dim);white-space:nowrap">views/card/</span>
                  <input class="form-input" type="text" name="base_template" id="baseTemplate" value="<%= theme ? (theme.template_name || '') : '' %>" required placeholder="e.g. cyberpunk-NYK" pattern="[a-zA-Z0-9_-]+" onchange="reloadPreview()">
                  <span style="font-family:var(--mono,'monospace');font-size:11px;color:var(--text-dim)">.ejs</span>
                </div>
                <small class="form-hint">Available files: <% systemThemes.forEach((st, i) => { %><code><%= st.template_name %></code><%= i < systemThemes.length - 1 ? ', ' : '' %><% }) %></small>
              </div>
            </div>

            <div class="form-section">
              <h3 class="form-section-title">Color Palette</h3>

              <div class="color-grid">
                <div class="color-field">
                  <label class="form-label">Background</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.bg || '#050d1a' %>" data-field="bg" data-css="--bg" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.bg || '#050d1a' %>" data-field="bg" data-css="--bg" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Card</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.card || '#0a1628' %>" data-field="card" data-css="--card" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.card || '#0a1628' %>" data-field="card" data-css="--card" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Border</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.border || '#1a3060' %>" data-field="border" data-css="--border" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.border || '#1a3060' %>" data-field="border" data-css="--border" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Primary Accent</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.accent || '#00d4ff' %>" data-field="accent" data-css="--accent" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.accent || '#00d4ff' %>" data-field="accent" data-css="--accent" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Secondary Accent</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.accent2 || '#0066ff' %>" data-field="accent2" data-css="--accent2" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.accent2 || '#0066ff' %>" data-field="accent2" data-css="--accent2" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Tertiary Accent</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.accent3 || '#00ff9d' %>" data-field="accent3" data-css="--accent3" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.accent3 || '#00ff9d' %>" data-field="accent3" data-css="--accent3" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Gold / Highlight</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.gold || '#ffc857' %>" data-field="gold" data-css="--gold" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.gold || '#ffc857' %>" data-field="gold" data-css="--gold" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Text Color</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.text || '#c8daf0' %>" data-field="text" data-css="--text" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.text || '#c8daf0' %>" data-field="text" data-css="--text" oninput="updateColorText(this)">
                  </div>
                </div>
                <div class="color-field">
                  <label class="form-label">Dim Text</label>
                  <div class="color-input-wrap">
                    <input type="color" class="color-picker" value="<%= currentVars.textDim || '#4a6a8a' %>" data-field="textDim" data-css="--text-dim" oninput="updateColor(this)">
                    <input class="form-input color-text" type="text" value="<%= currentVars.textDim || '#4a6a8a' %>" data-field="textDim" data-css="--text-dim" oninput="updateColorText(this)">
                  </div>
                </div>
              </div>

              <h3 class="form-section-title" style="margin-top: 24px;">Typography</h3>

              <div class="form-group">
                <label class="form-label">Google Fonts Import</label>
                <input class="form-input" type="text" id="googleFonts" value="<%= currentVars.googleFonts || '' %>" placeholder="Auto-generated from font selections (or type manually)">
                <small class="form-hint">Auto-composed from selections above · Pipe-separated families · Editable</small>
              </div>
              <div class="form-group">
                <label class="form-label">Sans-serif Font (Body)</label>
                <div class="font-selector-wrap">
                  <select id="fontSansLib" onchange="selectFont(this,'fontSans','sans')">
                    <option value="">— Select from library —</option>
                  </select>
                  <input class="form-input" type="text" id="fontSans" value="<%= currentVars.fontSans || '' %>" placeholder="e.g. 'Inter', sans-serif" onchange="pushFontToPreview()">
                  <small>Used for body text, general content</small>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Monospace Font (Labels / UI)</label>
                <div class="font-selector-wrap">
                  <select id="fontMonoLib" onchange="selectFont(this,'fontMono','mono')">
                    <option value="">— Select from library —</option>
                  </select>
                  <input class="form-input" type="text" id="fontMono" value="<%= currentVars.fontMono || '' %>" placeholder="e.g. 'JetBrains Mono', monospace" onchange="pushFontToPreview()">
                  <small>Used for labels, badges, system info</small>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Display / Condensed Font (Headings)</label>
                <div class="font-selector-wrap">
                  <select id="fontCondLib" onchange="selectFont(this,'fontCond','display')">
                    <option value="">— Select from library —</option>
                  </select>
                  <input class="form-input" type="text" id="fontCond" value="<%= currentVars.fontCond || '' %>" placeholder="e.g. 'Barlow Condensed', sans-serif" onchange="pushFontToPreview()">
                  <small>Used for hero text, name, headings</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Hidden field for JSON -->
          <input type="hidden" name="css_variables" id="cssVariablesJson">

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg" onclick="buildJson()">
              <%= theme && theme.id ? '✓ SAVE CHANGES' : '⊕ CREATE THEME' %>
            </button>
            <a href="/admin/themes" class="btn btn-ghost">CANCEL</a>
          </div>
        </form>

        <% if (theme && theme.id && !theme.is_system) { %>
        <div class="form-actions" style="margin-top:24px; flex-direction:column; align-items:flex-start;">
          <h3 style="color:#ff4d6a; font-size:11px; font-family:var(--mono); letter-spacing:2px; text-transform:uppercase; margin-bottom:4px;">⚠ DANGER ZONE</h3>
          <form method="POST" action="/api/themes/<%= theme.id %>/delete" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this theme?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger">🗑 DELETE THEME</button>
          </form>
        </div>
        <% } %>
      </div>

      <!-- Right: Live Preview -->
      <div class="live-preview-panel">
        <div class="preview-header">
          <span class="dot"></span> Live Preview
        </div>
        <iframe id="previewFrame" name="previewFrame"></iframe>
      </div>
    </div>
  </main>

  <script>
    // ── Font Library ───────────────────────────
    var FONT_LIB = {
      sans: [
        { name: 'Barlow', family: "'Barlow', sans-serif", gf: 'Barlow:wght@300;400;600;700' },
        { name: 'Inter', family: "'Inter', sans-serif", gf: 'Inter:wght@300;400;500;600;700' },
        { name: 'Noto Sans', family: "'Noto Sans', sans-serif", gf: 'Noto+Sans:wght@300;400;600;700' },
        { name: 'Noto Sans Thai', family: "'Noto Sans Thai', sans-serif", gf: 'Noto+Sans+Thai:wght@300;400;600;700' },
        { name: 'Kanit', family: "'Kanit', sans-serif", gf: 'Kanit:wght@300;400;500;600;700' },
        { name: 'Prompt', family: "'Prompt', sans-serif", gf: 'Prompt:wght@300;400;500;600;700' },
        { name: 'Sarabun', family: "'Sarabun', sans-serif", gf: 'Sarabun:wght@300;400;600;700' },
        { name: 'IBM Plex Sans Thai', family: "'IBM Plex Sans Thai', sans-serif", gf: 'IBM+Plex+Sans+Thai:wght@300;400;500;600;700' },
        { name: 'Rajdhani', family: "'Rajdhani', sans-serif", gf: 'Rajdhani:wght@400;500;600;700' },
        { name: 'Lato', family: "'Lato', sans-serif", gf: 'Lato:wght@300;400;700;900' },
        { name: 'Roboto', family: "'Roboto', sans-serif", gf: 'Roboto:wght@300;400;500;700' },
        { name: 'Open Sans', family: "'Open Sans', sans-serif", gf: 'Open+Sans:wght@300;400;600;700' },
        { name: 'Poppins', family: "'Poppins', sans-serif", gf: 'Poppins:wght@300;400;500;600;700' },
        { name: 'Nunito', family: "'Nunito', sans-serif", gf: 'Nunito:wght@300;400;600;700' },
        { name: 'Chakra Petch', family: "'Chakra Petch', sans-serif", gf: 'Chakra+Petch:wght@300;400;500;600;700' },
        { name: 'Orbitron', family: "'Orbitron', sans-serif", gf: 'Orbitron:wght@400;500;600;700;800;900' },
      ],
      mono: [
        { name: 'Share Tech Mono', family: "'Share Tech Mono', monospace", gf: 'Share+Tech+Mono' },
        { name: 'Space Mono', family: "'Space Mono', monospace", gf: 'Space+Mono:wght@400;700' },
        { name: 'JetBrains Mono', family: "'JetBrains Mono', monospace", gf: 'JetBrains+Mono:wght@300;400;500;700' },
        { name: 'Fira Code', family: "'Fira Code', monospace", gf: 'Fira+Code:wght@300;400;500;600;700' },
        { name: 'IBM Plex Mono', family: "'IBM Plex Mono', monospace", gf: 'IBM+Plex+Mono:wght@300;400;500;600;700' },
        { name: 'Source Code Pro', family: "'Source Code Pro', monospace", gf: 'Source+Code+Pro:wght@300;400;500;600;700' },
        { name: 'DM Mono', family: "'DM Mono', monospace", gf: 'DM+Mono:wght@300;400;500' },
        { name: 'Roboto Mono', family: "'Roboto Mono', monospace", gf: 'Roboto+Mono:wght@300;400;500;600;700' },
        { name: 'Ubuntu Mono', family: "'Ubuntu Mono', monospace", gf: 'Ubuntu+Mono:wght@400;700' },
      ],
      display: [
        { name: 'Barlow Condensed', family: "'Barlow Condensed', sans-serif", gf: 'Barlow+Condensed:wght@400;600;700;800' },
        { name: 'Playfair Display', family: "'Playfair Display', serif", gf: 'Playfair+Display:wght@400;500;600;700;800;900' },
        { name: 'Rajdhani', family: "'Rajdhani', sans-serif", gf: 'Rajdhani:wght@400;500;600;700' },
        { name: 'Oswald', family: "'Oswald', sans-serif", gf: 'Oswald:wght@300;400;500;600;700' },
        { name: 'Anton', family: "'Anton', sans-serif", gf: 'Anton' },
        { name: 'Bebas Neue', family: "'Bebas Neue', sans-serif", gf: 'Bebas+Neue' },
        { name: 'Orbitron', family: "'Orbitron', sans-serif", gf: 'Orbitron:wght@400;500;600;700;800;900' },
        { name: 'Teko', family: "'Teko', sans-serif", gf: 'Teko:wght@300;400;500;600;700' },
        { name: 'Kanit', family: "'Kanit', sans-serif", gf: 'Kanit:wght@300;400;500;600;700' },
        { name: 'Chakra Petch', family: "'Chakra Petch', sans-serif", gf: 'Chakra+Petch:wght@300;400;500;600;700' },
        { name: 'Archivo Black', family: "'Archivo Black', sans-serif", gf: 'Archivo+Black' },
        { name: 'Russo One', family: "'Russo One', sans-serif", gf: 'Russo+One' },
        { name: 'Prompt', family: "'Prompt', sans-serif", gf: 'Prompt:wght@300;400;500;600;700' },
        { name: 'Saira Condensed', family: "'Saira Condensed', sans-serif", gf: 'Saira+Condensed:wght@400;500;600;700;800' },
      ]
    };

    // ── Populate <select> dropdowns ────────────
    function populateFontSelects() {
      var mapping = [
        { selectId: 'fontSansLib', inputId: 'fontSans', cat: 'sans' },
        { selectId: 'fontMonoLib', inputId: 'fontMono', cat: 'mono' },
        { selectId: 'fontCondLib', inputId: 'fontCond', cat: 'display' }
      ];
      mapping.forEach(function(m) {
        var sel = document.getElementById(m.selectId);
        var inp = document.getElementById(m.inputId);
        if (!sel || !inp) return;
        var currentVal = inp.value.trim();
        FONT_LIB[m.cat].forEach(function(f) {
          var opt = document.createElement('option');
          opt.value = f.name;
          opt.textContent = f.name;
          // Pre-select if current value matches
          if (currentVal && currentVal.indexOf(f.name) !== -1) {
            opt.selected = true;
          }
          sel.appendChild(opt);
        });
      });
    }
    populateFontSelects();

    // ── Font selection from dropdown ───────────
    function selectFont(selectEl, inputId, category) {
      var fontName = selectEl.value;
      var input = document.getElementById(inputId);
      if (!fontName) return; // "Select from library" chosen
      var entry = FONT_LIB[category].find(function(f) { return f.name === fontName; });
      if (!entry) return;
      input.value = entry.family;
      rebuildGoogleFonts();
      loadFontInPreview(entry.gf);
      pushFontToPreview();
    }

    // ── Rebuild Google Fonts import string ─────
    function rebuildGoogleFonts() {
      var parts = [];
      var seen = {};
      var mapping = [
        { selectId: 'fontSansLib', cat: 'sans' },
        { selectId: 'fontMonoLib', cat: 'mono' },
        { selectId: 'fontCondLib', cat: 'display' }
      ];
      mapping.forEach(function(m) {
        var sel = document.getElementById(m.selectId);
        if (!sel || !sel.value) return;
        var entry = FONT_LIB[m.cat].find(function(f) { return f.name === sel.value; });
        if (entry && !seen[entry.gf]) {
          parts.push(entry.gf);
          seen[entry.gf] = true;
        }
      });
      document.getElementById('googleFonts').value = parts.join('|');
    }

    // ── Load a font into the preview iframe ────
    function loadFontInPreview(gfParam) {
      try {
        var doc = document.getElementById('previewFrame').contentDocument;
        if (!doc || !doc.head) return;
        var linkId = 'gf-' + gfParam.replace(/[^a-zA-Z0-9]/g, '_');
        if (doc.getElementById(linkId)) return; // already loaded
        var link = doc.createElement('link');
        link.id = linkId;
        link.rel = 'stylesheet';
        link.href = 'https://fonts.googleapis.com/css2?family=' + gfParam + '&display=swap';
        doc.head.appendChild(link);
      } catch (e) {}
    }

    // ── Color sync + live push ─────────────────
    function updateColor(picker) {
      var field = picker.dataset.field;
      var cssVar = picker.dataset.css;
      var textInput = document.querySelector('.color-text[data-field="' + field + '"]');
      if (textInput) textInput.value = picker.value;
      pushCssVar(cssVar, picker.value);
    }

    function updateColorText(input) {
      var field = input.dataset.field;
      var cssVar = input.dataset.css;
      var picker = document.querySelector('.color-picker[data-field="' + field + '"]');
      if (picker && /^#[0-9a-f]{6}$/i.test(input.value)) {
        picker.value = input.value;
      }
      pushCssVar(cssVar, input.value);
    }

    // ── Push single CSS var into iframe ────────
    function pushCssVar(cssVar, value) {
      try {
        var doc = document.getElementById('previewFrame').contentDocument;
        if (doc && doc.documentElement) {
          doc.documentElement.style.setProperty(cssVar, value);
        }
      } catch (e) {}
    }

    // ── Push font changes into iframe ──────────
    function pushFontToPreview() {
      try {
        var doc = document.getElementById('previewFrame').contentDocument;
        if (!doc || !doc.documentElement) return;
        var s = document.getElementById('fontSans').value;
        var m = document.getElementById('fontMono').value;
        var c = document.getElementById('fontCond').value;
        if (s) doc.documentElement.style.setProperty('--sans', s);
        if (m) doc.documentElement.style.setProperty('--mono', m);
        if (c) doc.documentElement.style.setProperty('--cond', c);
      } catch (e) {}
    }

    // ── Build JSON for form submit ─────────────
    function buildJson() {
      var vars = {};
      document.querySelectorAll('.color-text').forEach(function(el) {
        vars[el.dataset.field] = el.value;
      });
      vars.googleFonts = document.getElementById('googleFonts').value;
      vars.fontSans = document.getElementById('fontSans').value;
      vars.fontMono = document.getElementById('fontMono').value;
      vars.fontCond = document.getElementById('fontCond').value;
      Object.keys(vars).forEach(function(k) { if (!vars[k]) delete vars[k]; });
      document.getElementById('cssVariablesJson').value = JSON.stringify(vars);
    }

    document.getElementById('themeForm').addEventListener('submit', function() {
      buildJson();
    });

    // ── Load / reload preview via POST ─────────
    function reloadPreview() {
      buildJson();
      var tpl = document.getElementById('baseTemplate').value || 'cyberpunk-NYK';
      var json = document.getElementById('cssVariablesJson').value;

      var f = document.createElement('form');
      f.method = 'POST';
      f.action = '/admin/themes/preview';
      f.target = 'previewFrame';
      f.style.display = 'none';

      var i1 = document.createElement('input');
      i1.name = '_csrf'; i1.value = '<%= csrfToken %>';
      f.appendChild(i1);

      var i2 = document.createElement('input');
      i2.name = 'css_variables'; i2.value = json;
      f.appendChild(i2);

      var i3 = document.createElement('input');
      i3.name = 'template_name'; i3.value = tpl;
      f.appendChild(i3);

      document.body.appendChild(f);
      f.submit();
      f.remove();
    }

    // Load preview on page load
    reloadPreview();
  </script>
</body>
</html>
