<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= adminUser && adminUser.id ? 'Edit' : 'New' %> Admin – E-Card Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= adminUser && adminUser.id ? 'Edit' : 'New' %> Admin</h1>
        <p class="page-subtitle">
          <% if (adminUser && adminUser.id) { %>
            Editing: <%= adminUser.username %>
          <% } else { %>
            Create a new administrator account
          <% } %>
        </p>
      </div>
      <div class="header-actions">
        <a href="/admin/admins" class="btn btn-ghost">← BACK</a>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <form
      method="POST"
      action="<%= adminUser && adminUser.id ? '/api/admins/' + adminUser.id + '/update' : '/api/admins' %>"
      class="card-form"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-grid">
        <div class="form-section">
          <h3 class="form-section-title">Account Information</h3>

          <div class="form-group">
            <label class="form-label">Username *</label>
            <input class="form-input" type="text" name="username" value="<%= adminUser ? (adminUser.username || '') : '' %>" required pattern="[a-zA-Z0-9_-]+" placeholder="e.g. john_doe" <%= adminUser && adminUser.id ? 'readonly style="opacity:0.6;cursor:not-allowed;"' : '' %>>
            <% if (!(adminUser && adminUser.id)) { %>
              <small class="form-hint">Letters, numbers, hyphens, underscores only. Cannot be changed later.</small>
            <% } %>
          </div>

          <div class="form-group">
            <label class="form-label">Display Name</label>
            <input class="form-input" type="text" name="display_name" value="<%= adminUser ? (adminUser.display_name || '') : '' %>" placeholder="e.g. John Doe">
          </div>

          <div class="form-group">
            <label class="form-label">Email</label>
            <input class="form-input" type="email" name="email" value="<%= adminUser ? (adminUser.email || '') : '' %>" placeholder="e.g. john@example.com">
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">
            <% if (adminUser && adminUser.id) { %>
              Reset Password
            <% } else { %>
              Set Password
            <% } %>
          </h3>

          <% if (adminUser && adminUser.id) { %>
            <p style="font-size:13px;color:var(--text-dim);margin-bottom:16px;">Leave blank to keep the current password.</p>
          <% } %>

          <div class="form-group">
            <label class="form-label">Password <% if (!(adminUser && adminUser.id)) { %>*<% } %></label>
            <input class="form-input" type="password" name="password" minlength="6" placeholder="<%= adminUser && adminUser.id ? 'Enter new password to reset' : 'Minimum 6 characters' %>" <%= !(adminUser && adminUser.id) ? 'required' : '' %> autocomplete="new-password">
          </div>

          <div class="form-group">
            <label class="form-label">Confirm Password <% if (!(adminUser && adminUser.id)) { %>*<% } %></label>
            <input class="form-input" type="password" name="confirm_password" minlength="6" placeholder="Re-enter password" <%= !(adminUser && adminUser.id) ? 'required' : '' %> autocomplete="new-password">
          </div>

          <% if (adminUser && adminUser.id) { %>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" name="is_active">
              <option value="1" <%= adminUser.is_active ? 'selected' : '' %>>Active</option>
              <option value="0" <%= !adminUser.is_active ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
          <% } %>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">
          <%= adminUser && adminUser.id ? '✓ SAVE CHANGES' : '⊕ CREATE ADMIN' %>
        </button>
        <a href="/admin/admins" class="btn btn-ghost">CANCEL</a>
      </div>
    </form>

    <% if (adminUser && adminUser.id) { %>
    <div class="form-actions" style="margin-top:24px; flex-direction:column; align-items:flex-start;">
      <h3 style="color:#ff4d6a; font-size:11px; font-family:var(--mono); letter-spacing:2px; text-transform:uppercase; margin-bottom:4px;">⚠ DANGER ZONE</h3>
      <form method="POST" action="/api/admins/<%= adminUser.id %>/delete" style="display:inline" onsubmit="return confirm('Are you sure you want to delete admin \'<%= adminUser.username %>\'? This action cannot be undone.')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-danger">🗑 DELETE ADMIN</button>
      </form>
    </div>
    <% } %>
  </main>
</body>
</html>
