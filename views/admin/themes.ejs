<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Themes – E-Card Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="page-header">
      <div>
        <h1 class="page-title">Themes</h1>
        <p class="page-subtitle">Manage card themes and visual styles</p>
      </div>
      <div class="header-actions">
        <a href="/admin/themes/new" class="btn btn-primary">⊕ NEW THEME</a>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">⚠ <%= error %></div>
    <% } %>

    <div class="themes-grid">
      <% themes.forEach(t => { %>
        <div class="theme-card">
          <div class="theme-card-header theme-<%= t.slug %>">
            <div class="theme-card-name"><%= t.name %></div>
            <% if (t.is_system) { %><span class="theme-system-badge">System</span><% } %>
          </div>
          <div class="theme-card-body">
            <p class="theme-card-desc"><%= t.description || 'No description' %></p>
            <div class="theme-card-meta">
              <span class="meta-item">📄 <%= t.card_count %> card<%= t.card_count !== 1 ? 's' : '' %></span>
              <span class="meta-item">🎨 <%= t.template_name %></span>
              <span class="meta-item">📁 views/card/<%= t.template_name %>.ejs</span>
            </div>
          </div>
          <div class="theme-card-actions">
            <button onclick="openPreview(<%= t.id %>)" class="btn btn-sm btn-primary">👁 Preview</button>
            <a href="/admin/themes/<%= t.id %>/copy" class="btn btn-sm btn-secondary">⧉ Copy</a>
            <a href="/admin/themes/<%= t.id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
            <% if (!t.is_system) { %>
              <form method="POST" action="/api/themes/<%= t.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this theme? This cannot be undone.')">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </main>

  <!-- Preview Modal -->
  <div id="previewOverlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.8);backdrop-filter:blur(4px);align-items:center;justify-content:center" onclick="if(event.target===this)closePreview()">
    <div style="position:relative;width:480px;max-width:95vw;height:90vh;border-radius:12px;overflow:hidden;box-shadow:0 0 60px rgba(0,0,0,0.5)">
      <button onclick="closePreview()" style="position:absolute;top:10px;right:10px;z-index:10;background:rgba(0,0,0,0.6);color:#fff;border:none;width:32px;height:32px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center">✕</button>
      <iframe id="previewFrame" style="width:100%;height:100%;border:none;background:#111"></iframe>
    </div>
  </div>

  <script>
    function openPreview(id) {
      var overlay = document.getElementById('previewOverlay');
      var frame = document.getElementById('previewFrame');
      frame.src = '/admin/themes/' + id + '/preview';
      overlay.style.display = 'flex';
    }
    function closePreview() {
      var overlay = document.getElementById('previewOverlay');
      var frame = document.getElementById('previewFrame');
      overlay.style.display = 'none';
      frame.src = '';
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closePreview();
    });
  </script>
</body>
</html>
