<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 – Not Found</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@700;800&display=swap" rel="stylesheet">
<style>
  :root { --bg: #050d1a; --accent: #00d4ff; --accent3: #00ff9d; --text: #c8daf0; --text-dim: #4a6a8a; }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); font-family: 'Barlow', sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: var(--text); }
  .error-page { text-align: center; }
  .error-code { font-family: 'Barlow Condensed', sans-serif; font-size: 120px; font-weight: 800; color: var(--accent); line-height: 1; opacity: 0.3; }
  .error-text { font-family: 'Share Tech Mono', monospace; font-size: 14px; color: var(--text-dim); letter-spacing: 3px; margin-top: 10px; }
  .error-link { display: inline-block; margin-top: 30px; font-family: 'Share Tech Mono', monospace; font-size: 12px; color: var(--accent3); text-decoration: none; letter-spacing: 2px; border: 1px solid rgba(0,255,157,0.3); padding: 10px 24px; border-radius: 8px; transition: all 0.2s; }
  .error-link:hover { background: rgba(0,255,157,0.08); border-color: var(--accent3); }
</style>
</head>
<body>
  <div class="error-page">
    <div class="error-code">404</div>
    <div class="error-text">RESOURCE NOT FOUND</div>
    <a href="/" class="error-link">← RETURN HOME</a>
  </div>
</body>
</html>
