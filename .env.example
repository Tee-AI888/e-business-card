SESSION_SECRET=change-this-to-a-strong-random-string
ADMIN_PASSWORD=change-this-to-your-admin-password
PORT=3000
NODE_ENV=development
# Set to true when the app is served over HTTPS (reverse proxy or TLS); enables Helmet COOP/HSTS/upgrade-insecure-requests
USE_HTTPS=false
# Login/API rate limits
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100
# Comma-separated allowed origins for browser API calls (omit to reflect request Origin)
# CORS_ORIGIN=https://your-frontend.example.com,http://localhost:5173
